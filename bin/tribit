#!/usr/bin/env node
'use strict';

const path = require('path');
const fs = require('fs');
const http = require('http');
const https = require('https');
const net = require('net');
const { exec, spawn } = require('child_process');

const CURRENT_VERSION = require('../package.json').version;

// ── ANSI ──────────────────────────────────────────────────────
const R  = '\x1b[0m';
const B  = '\x1b[1m';
const D  = '\x1b[2m';
const CY = '\x1b[96m';
const GR = '\x1b[92m';
const WH = '\x1b[97m';
const GM = '\x1b[90m';

const FRAMES = ['⠋','⠙','⠹','⠸','⠼','⠴','⠦','⠧','⠇','⠏'];

function clearLine() { process.stdout.write('\r\x1b[2K'); }

function startSpinner(text) {
  let i = 0;
  process.stdout.write('\n');
  const id = setInterval(() => {
    clearLine();
    process.stdout.write(`  ${CY}${FRAMES[i++ % FRAMES.length]}${R}  ${text}`);
  }, 80);
  return id;
}

function stopSpinner(id) { clearInterval(id); clearLine(); }

function showRunningBox() {
  const W = 41;
  const HR = '═'.repeat(W + 2);
  const empty = `║ ${' '.repeat(W)} ║`;

  function row(text, vis) {
    return `║ ${text}${' '.repeat(W - vis)} ║`;
  }

  const lines = [
    `╔${HR}╗`,
    empty,
    row(`  ${B}${CY}tribit${R}  ${GR}● running${R}`, 19),
    empty,
    row(`  ${WH}Enjoy your agentic dev experience${R}`, 35),
    row(`  ${D}Currently in beta${R}`, 19),
    empty,
    row(`  ${GM}Ctrl+C or close this terminal to stop${R}`, 40),
    empty,
    `╚${HR}╝`,
  ];

  process.stdout.write('\n' + lines.join('\n') + '\n\n');
}

// ── Browser ───────────────────────────────────────────────────
const APP_BROWSERS = process.platform === 'darwin'
  ? [
      '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',
      '/Applications/Chromium.app/Contents/MacOS/Chromium',
      '/Applications/Brave Browser.app/Contents/MacOS/Brave Browser',
      '/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge',
    ]
  : process.platform === 'win32'
  ? [
      process.env.LOCALAPPDATA && path.join(process.env.LOCALAPPDATA, 'Google', 'Chrome', 'Application', 'chrome.exe'),
      process.env.PROGRAMFILES && path.join(process.env.PROGRAMFILES, 'Google', 'Chrome', 'Application', 'chrome.exe'),
      process.env['PROGRAMFILES(X86)'] && path.join(process.env['PROGRAMFILES(X86)'], 'Google', 'Chrome', 'Application', 'chrome.exe'),
      process.env.LOCALAPPDATA && path.join(process.env.LOCALAPPDATA, 'Microsoft', 'Edge', 'Application', 'msedge.exe'),
      process.env.PROGRAMFILES && path.join(process.env.PROGRAMFILES, 'Microsoft', 'Edge', 'Application', 'msedge.exe'),
      process.env['PROGRAMFILES(X86)'] && path.join(process.env['PROGRAMFILES(X86)'], 'Microsoft', 'Edge', 'Application', 'msedge.exe'),
    ].filter(Boolean)
  : [];

function openApp(url, newWindow = true) {
  const browser = APP_BROWSERS.find((p) => fs.existsSync(p));
  if (browser) {
    exec(`"${browser}" ${newWindow ? `--app=${url} --new-window` : `--app=${url}`}`);
  } else if (process.platform === 'win32') {
    exec(`start "" "${url}"`, { shell: true });
  } else if (process.platform === 'darwin') {
    exec(`open "${url}"`);
  } else {
    exec(`xdg-open "${url}"`);
  }
}

// ── Networking ────────────────────────────────────────────────
const DEFAULT_PORT = parseInt(process.env.PORT || '7700', 10);

function probeRunning(port) {
  return new Promise((resolve) => {
    const req = http.get(`http://localhost:${port}/api/status`, { timeout: 1000 }, (res) => {
      resolve(res.statusCode < 500);
    });
    req.on('error', () => resolve(false));
    req.on('timeout', () => { req.destroy(); resolve(false); });
  });
}

function findPort(start) {
  return new Promise((resolve) => {
    const s = net.createServer();
    s.listen(start, () => { const p = s.address().port; s.close(() => resolve(p)); });
    s.on('error', () => resolve(findPort(start + 1)));
  });
}

function waitForServer(port, attempts = 30) {
  return new Promise((resolve) => {
    let left = attempts;
    const tick = () => probeRunning(port).then((ok) => {
      if (ok) return resolve(true);
      if (--left <= 0) return resolve(false);
      setTimeout(tick, 300);
    });
    tick();
  });
}

// ── Update check ──────────────────────────────────────────────
function checkForUpdate() {
  https.get('https://registry.npmjs.org/tribit/latest', { timeout: 3000 }, (res) => {
    let data = '';
    res.on('data', (c) => { data += c; });
    res.on('end', () => {
      try {
        const latest = JSON.parse(data).version;
        if (latest && latest !== CURRENT_VERSION) {
          process.stdout.write(`  ${GM}Update available: ${CURRENT_VERSION} → ${latest}  →  npx tribit@latest${R}\n\n`);
        }
      } catch {}
    });
  }).on('error', () => {});
}

// ── Main ──────────────────────────────────────────────────────
probeRunning(DEFAULT_PORT).then((running) => {
  if (running) {
    process.stdout.write(`\n  ${GR}●${R}  tribit is already running — opening window...\n\n`);
    openApp(`http://localhost:${DEFAULT_PORT}`, false);
    checkForUpdate();
    return;
  }

  const spinner = startSpinner('Starting tribit...');

  findPort(DEFAULT_PORT).then((port) => {
    const serverPath = path.join(__dirname, '..', 'server.js');

    // Server is NOT detached — closing this terminal kills it
    const child = spawn(process.execPath, [serverPath], {
      stdio: 'ignore',
      windowsHide: true,
      env: { ...process.env, TRIBIT_CWD: process.cwd(), PORT: String(port) },
    });

    const shutdown = () => { try { child.kill(); } catch {} };
    process.on('exit', shutdown);
    process.on('SIGINT', () => { process.stdout.write('\n'); process.exit(0); });
    process.on('SIGTERM', () => process.exit(0));

    // If server crashes, exit the terminal too
    child.on('exit', () => process.exit(0));

    waitForServer(port).then((ok) => {
      stopSpinner(spinner);
      if (ok) {
        showRunningBox();
        openApp(`http://localhost:${port}`);
        checkForUpdate();
      }
    });
  });
});
