{
  "name": "tribit",
  "version": "1.2.3",
  "description": "Git worktree manager with web UI and AI agent integration",
  "author": "Ritik Rana",
  "main": "server.js",
  "bin": {
    "tribit": "./bin/tribit"
  },
  "files": [
    "bin",
    "dist",
    "server.js"
  ],
  "scripts": {
    "dev": "concurrently \"node server.js\" \"vite --port 5173\"",
    "build": "vite build",
    "prepare": "vite build",
    "start": "node server.js",
    "restart": "pkill -f 'node.*tribit' 2>/dev/null || true; npm run build && node bin/tribit",
    "postinstall": "node -e \"if(process.platform==='darwin'){try{require('fs').chmodSync(require('path').join('node_modules','node-pty','prebuilds','darwin-arm64','spawn-helper'),0o755)}catch{}}\""
  },
  "dependencies": {
    "express": "^4.18.2",
    "node-pty": "^1.1.0",
    "ws": "^8.20.0"
  },
  "overrides": {
    "dompurify": "^3.4.2"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^8.2.2",
    "lucide-react": "^1.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reactflow": "^11.11.4",
    "vite": "^8.0.12"
  }
}
