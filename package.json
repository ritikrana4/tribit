{
  "name": "wooop",
  "version": "1.0.0",
  "description": "Git worktree manager with web UI and Copilot integration",
  "main": "server.js",
  "bin": {
    "wooop": "./bin/wooop"
  },
  "scripts": {
    "dev": "concurrently \"node server.js\" \"vite --port 5173\"",
    "build": "vite build",
    "prepare": "vite build",
    "start": "node server.js",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-arm64/spawn-helper 2>/dev/null || true"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^4.18.2",
    "lucide-react": "^1.14.0",
    "node-pty": "^1.1.0",
    "reactflow": "^11.11.4",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^5.0.8"
  }
}
